<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        id="my_account_link"
        name="Link to frontend portal"
        inherit_id="portal.user_dropdown"
    >
        <xpath expr="//*[@id='o_logout_divider']" position="before">
            <a href="/my/payment-account" role="menuitem" class="dropdown-item ps-3">
                <i
                    class="fa fa-fw fa-file-text-o me-1 small text-muted"
                /> My Payment Account
            </a>
        </xpath>
    </template>

</odoo>
